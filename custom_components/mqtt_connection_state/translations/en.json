{
  "title": "MQTT connection state",
  "config": {
    "step": {
      "user": {
        "title": "MQTT connection state",
        "description": "Choose a device to configure.",
        "data": {
          "device_id": "Device"
        }
      },
      "from_discovery": {
        "title": "MQTT connection state",
        "description": "Configure from discovered: \"{device_name}\".\nTopic: \"{connection_topic}\"."
      }
    },
    "error": {
      "unknown": "An unknown error occurred",
      "device_unknown": "This is an unknown device, please change your selection.",
      "no_connection_topic": "No topic found ending in /availability or /state"
    }
  },
  "entity": {
    "binary_sensor": {
      "connection_state": {
        "name": "Connection",
        "state": {
          "on": "Connected",
          "off": "Disconnected"
        }
      },
      "broker_connection_state": {
        "name": "Connection",
        "state": {
          "on": "Connected",
          "off": "Disconnected"
        }
      },
      "bridge_connection_state": {
        "name": "Bridge",
        "state": {
          "on": "Online",
          "off": "Offline"
        }
      }
    }
  },
  "issues": {
    "duplicate_entries": {
      "title": "Duplicate configuration entries ({count})",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Remove duplicate configuration entries",
            "description": "Discovery created {count} duplicate entries after the Home Assistant 2026.8 update changed device identifiers. Submitting removes the extras and keeps one entry per device; the remaining connection sensors are already linked to the correct devices and nothing else changes."
          }
        }
      }
    }
  }
}
